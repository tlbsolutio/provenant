# Provenant — bring your own keys. Copy to .env (gitignored) and fill what you need.
# Nothing here is required for the free core (kome transcript + noembed provenance).

# --- Transcript (timestamps) ---
# Supadata gives TIMESTAMPED segments. Free tier at https://supadata.ai
SUPADATA_API_KEY=

# --- AI analysis (summary / fact-check / bias) ---
# Choose ONE provider via --ai. Leave keys empty to use claude-cli (local Claude Code, no API cost).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Fact-check / web verification ---
TAVILY_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# --- Provenance (richer metadata: upload date, stats) ---
YOUTUBE_API_KEY=

# --- Archiving (authenticated Save Page Now) ---
ARCHIVE_ORG_ACCESS_KEY=
ARCHIVE_ORG_SECRET_KEY=

# --- Publishing (report.mjs --publish) ---
# Directory served as your site. Reports are written here as <id>.html + an index.
# Leave empty to skip publishing (report stays a local file). Supports a leading ~/.
PROVENANT_PUBLISH_DIR=
# A dir already linked to Vercel (.vercel/project.json) deploys automatically.
# Set to 1 to force `vercel deploy` even if the dir isn't linked yet.
PROVENANT_VERCEL=
